STAFF_TELEGRAM_NOTIFICATIONS_ENABLED=false
STAFF_TELEGRAM_BOT_TOKEN=
STAFF_TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
