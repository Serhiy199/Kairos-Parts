SMTP_FROM=

FILE_STORAGE_DRIVER=local
FILE_UPLOAD_MAX_SIZE_MB=20

OCR_PROVIDER=tesseract
OCR_API_KEY=

APP_BASE_URL=

# Explicitly set to mock only in local, test, or staging environments.
LOGISTICS_ADDRESS_PROVIDER=
# Safe default: keep the preview-only request form unavailable.
LOGISTICS_REQUEST_FORM_ENABLED=false
# Independent safe default: form visibility never enables database writes.
LOGISTICS_REQUEST_SUBMIT_ENABLED=false

CLOUDINARY_CLOUD_NAME=
