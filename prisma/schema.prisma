generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  GUEST
  CLIENT
  MANAGER
  ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuthRateLimitScope {
  IDENTIFIER
  IP
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum RequestSource {
  WEBSITE
  CLIENT_DASHBOARD
  TELEGRAM
  MANAGER
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  OFFER_PREPARING
  WAITING_APPROVAL
  AWAITING_INVOICE
  INVOICE_SENT
  AWAITING_SHIPMENT
  ORDERED
  IN_DELIVERY
  COMPLETED
  CANCELLED
}

enum RequestSelectionBatchStatus {
  DRAFT
  SENT
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SUPERSEDED
}

enum RequestSelectionBatchItemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OCRProvider {
  TESSERACT
  GOOGLE_VISION
  AWS_TEXTRACT
  AZURE_VISION
  OTHER
}

enum RequestDocumentType {
  COMMERCIAL_OFFER
  INVOICE
  SPECIFICATION
  ACT
  OTHER
}

enum CommercialOfferStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChangeEntityType {
  REQUEST
  REQUEST_ITEM
  VEHICLE
  REQUEST_DOCUMENT
  COMMERCIAL_OFFER
  COMPANY
  COMPANY_PROFILE
}

enum ChangeAction {
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
}

enum AuditEntityType {
  REQUEST
  REQUEST_ITEM
  REQUEST_SELECTION_BATCH
  REQUEST_SELECTION_BATCH_ITEM
  VEHICLE
  REQUEST_DOCUMENT
  DOCUMENT
  COMMERCIAL_OFFER
  INVOICE
  COMPANY
  CHANGE_REQUEST
  USER
  TEAM_MEMBER
  CLIENT
  EQUIPMENT_TYPE
  MANUFACTURER
  AUTH_SESSION
  AUTH_ATTEMPT
  INVITATION
  TELEGRAM_REQUEST
  LOGISTICS_REQUEST
  LOGISTICS_TARIFF_CITY
  SYSTEM
}

enum AuditAction {
  CHANGE_REQUEST_CREATED
  CHANGE_REQUEST_CANCELLED
  CHANGE_REQUEST_APPROVED
  CHANGE_REQUEST_REJECTED
  CHANGE_APPLIED
  VEHICLE_ARCHIVED
  ENTITY_UPDATED
  MANAGER_INVITATION_CREATED
  MANAGER_INVITATION_REGENERATED
  MANAGER_ACTIVATED
  MANAGER_DISABLED
  MANAGER_ENABLED
  AUTH_LOGIN_SUCCEEDED
  AUTH_LOGIN_FAILED
  AUTH_LOGIN_BLOCKED_DISABLED
  AUTH_LOGIN_BLOCKED_PENDING
  AUTH_LOGOUT
  AUTH_INVITATION_ACCEPTED
  AUTH_SESSION_INVALIDATED
  REQUEST_STATUS_CHANGED
  REQUEST_MANAGER_ASSIGNED
  REQUEST_MANAGER_REASSIGNED
  REQUEST_MANAGER_UNASSIGNED
  REQUEST_COMPANY_CHANGED
  REQUEST_ITEM_CREATED
  REQUEST_ITEM_UPDATED
  REQUEST_ITEM_DELETED
  REQUEST_ITEMS_SENT_FOR_APPROVAL
  REQUEST_ITEMS_CLIENT_APPROVAL_CHANGED
  REQUEST_SELECTION_BATCH_CREATED
  REQUEST_SELECTION_BATCH_SENT
  REQUEST_SELECTION_BATCH_APPROVED
  REQUEST_SELECTION_BATCH_PARTIALLY_APPROVED
  REQUEST_SELECTION_BATCH_REJECTED
  REQUEST_SELECTION_BATCH_SUPERSEDED
  REQUEST_SELECTION_ITEM_APPROVED
  REQUEST_SELECTION_ITEM_REJECTED
  COMMERCIAL_OFFER_CREATED
  COMMERCIAL_OFFER_UPDATED
  COMMERCIAL_OFFER_ITEMS_CHANGED
  COMMERCIAL_OFFER_SENT
  COMMERCIAL_OFFER_APPROVED
  COMMERCIAL_OFFER_REJECTED
  COMMERCIAL_OFFER_CANCELLED
  COMMERCIAL_OFFER_DELETED
  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_MARKED_PAID
  INVOICE_CANCELLED
  INVOICE_PDF_OPENED
  DOCUMENT_UPLOADED
  DOCUMENT_UPDATED
  DOCUMENT_RENAMED
  DOCUMENT_VISIBILITY_CHANGED
  DOCUMENT_DELETED
  DOCUMENT_DOWNLOADED
  COMPANY_UPDATED
  COMPANY_BILLING_UPDATED
  COMPANY_PRIMARY_CONTACT_CHANGED
  COMPANY_MEMBER_ADDED
  COMPANY_MEMBER_REMOVED
  CLIENT_BILLING_UPDATED
  LOGISTICS_REQUEST_CREATED
  LOGISTICS_STATUS_CHANGED
  LOGISTICS_INTERNAL_COMMENT_CREATED
  LOGISTICS_TARIFF_UPDATED
}

enum AuditLogCategory {
  TECHNICAL
  LOGIN
  CRITICAL_READ
  STANDARD
  FINANCIAL_CRITICAL
}

enum UsedEquipmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UsedEquipmentInquiryStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LogisticsRequestStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LogisticsDestinationType {
  KAIROS_BASE
  FARM
}

enum LogisticsAddressProvider {
  MOCK
  GOOGLE
}

model User {
  id                        String                      @id @default(cuid())
  name                      String?
  email                     String?                     @unique
  emailVerified             DateTime?
  image                     String?
  phone                     String?                     @unique
  normalizedPhone           String?                     @unique
  passwordHash              String?
  role                      UserRole                    @default(CLIENT)
  status                    UserStatus                  @default(ACTIVE)
  authVersion               Int                         @default(1)
  accounts                  Account[]
  sessions                  Session[]
  clientProfile             ClientProfile?
  managerProfile            ManagerProfile?
  companyMemberships        CompanyMember[]
  assignedRequests          Request[]                   @relation("AssignedManager")
  statusChanges             RequestStatusHistory[]      @relation("StatusChangedBy")
  comments                  RequestComment[]            @relation("RequestCommentAuthor")
  uploadedDocuments         RequestDocument[]           @relation("RequestDocumentUploadedBy")
  uploadedOwnerDocuments    Document[]                  @relation("DocumentUploadedBy")
  createdCommercialOffers   CommercialOffer[]           @relation("CommercialOfferCreatedBy")
  createdSelectionBatches   RequestSelectionBatch[]     @relation("RequestSelectionBatchCreatedBy")
  selectionBatchDecisions   RequestSelectionBatchItem[] @relation("RequestSelectionBatchItemDecisionBy")
  clientInvoices            Invoice[]                   @relation("InvoiceClient")
  createdInvoices           Invoice[]                   @relation("InvoiceCreatedBy")
  changeRequestsRequested   ChangeRequest[]             @relation("ChangeRequestRequestedBy")
  changeRequestsReviewed    ChangeRequest[]             @relation("ChangeRequestReviewedBy")
  archivedVehicles          Vehicle[]                   @relation("VehicleArchivedBy")
  auditLogs                 AuditLog[]                  @relation("AuditLogActor")
  managerInvitations        ManagerInvitation[]         @relation("ManagerInvitationUser")
  invitationsCreated        ManagerInvitation[]         @relation("ManagerInvitationCreatedBy")
  usedEquipmentCreated      UsedEquipment[]             @relation("UsedEquipmentCreatedBy")
  usedEquipmentUpdated      UsedEquipment[]             @relation("UsedEquipmentUpdatedBy")
  usedEquipmentInquiries    UsedEquipmentInquiry[]      @relation("UsedEquipmentInquiryAssignee")
  logisticsInternalComments LogisticsInternalComment[]  @relation("LogisticsInternalCommentAuthor")
  notifications             Notification[]
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthRateLimitBucket {
  id           String             @id @default(cuid())
  scope        AuthRateLimitScope
  keyHash      String             @db.Char(64)
  windowStart  DateTime           @default(now())
  attemptCount Int                @default(0)
  blockedUntil DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@index([updatedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ClientProfile {
  id                String                @id @default(cuid())
  userId            String                @unique
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientType        ClientType            @default(BUSINESS)
  companyName       String?
  taxId             String?
  contactName       String?
  firstName         String?
  lastName          String?
  phone             String?
  telegramUserId    String?               @unique
  telegramChatId    String?               @unique
  email             String?
  requests          Request[]
  logisticsRequests LogisticsRequest[]
  vehicles          Vehicle[]
  documents         Document[]
  billingDetails    ClientBillingDetails?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model Company {
  id                String                 @id @default(cuid())
  name              String
  edrpou            String?
  phone             String?
  email             String?
  legalAddress      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  members           CompanyMember[]
  requests          Request[]
  logisticsRequests LogisticsRequest[]
  vehicles          Vehicle[]
  documents         Document[]
  changeRequests    ChangeRequest[]
  auditLogs         AuditLog[]
  invoices          Invoice[]
  billingDetails    CompanyBillingDetails?

  @@unique([name, edrpou])
  @@index([edrpou])
}

model SellerBillingDetails {
  id           String   @id @default(cuid())
  legalName    String
  edrpou       String?
  ipn          String?
  iban         String?
  bankName     String?
  mfo          String?
  phone        String?
  email        String?
  legalAddress String?
  isDefault    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isDefault])
}

model CompanyBillingDetails {
  id            String   @id @default(cuid())
  companyId     String   @unique
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  legalName     String?
  edrpou        String?
  ipn           String?
  iban          String?
  bankName      String?
  legalAddress  String?
  contactPerson String?
  phone         String?
  email         String?
  vatPayer      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ClientBillingDetails {
  id              String        @id @default(cuid())
  clientProfileId String        @unique
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  legalName       String?
  edrpou          String?
  ipn             String?
  iban            String?
  bankName        String?
  legalAddress    String?
  contactPerson   String?
  phone           String?
  email           String?
  vatPayer        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ChangeRequest {
  id            String              @id @default(cuid())
  companyId     String?
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  requestedById String
  requestedBy   User                @relation("ChangeRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedById  String?
  reviewedBy    User?               @relation("ChangeRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  entityType    ChangeEntityType
  entityId      String
  action        ChangeAction
  status        ChangeRequestStatus @default(PENDING)
  fieldName     String?
  oldValue      Json?
  newValue      Json?
  reason        String?
  adminComment  String?
  auditLogs     AuditLog[]
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([companyId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id              String           @id @default(cuid())
  actorId         String?
  actor           User?            @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName       String?
  actorEmail      String?
  actorRole       UserRole?
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  changeRequestId String?
  changeRequest   ChangeRequest?   @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  entityType      AuditEntityType
  entityId        String
  entityLabel     String?
  action          AuditAction
  category        AuditLogCategory
  oldValue        Json?
  newValue        Json?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime         @default(now())
  expiresAt       DateTime

  @@index([companyId])
  @@index([changeRequestId])
  @@index([action])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([category, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model CompanyMember {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPrimaryContact Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, userId])
  @@unique([userId])
  @@index([companyId])
}

model ManagerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ManagerInvitation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("ManagerInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation("ManagerInvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt, revokedAt])
}

model Request {
  id                       String                  @id @default(cuid())
  requestNumber            String                  @unique @default(dbgenerated("'KP-'::text || nextval('request_number_seq'::regclass)::text"))
  publicStatusToken        String                  @unique
  source                   RequestSource
  status                   RequestStatus           @default(NEW)
  selectionRevisionCounter Int                     @default(0)
  clientId                 String?
  client                   ClientProfile?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyId                String?
  company                  Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  guestName                String?
  guestPhone               String?
  guestEmail               String?
  companyName              String?
  categoryId               String?
  category                 Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId            String?
  subcategory              Subcategory?            @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  manufacturerId           String?
  manufacturer             Manufacturer?           @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  manufacturerName         String?
  vehicleId                String?
  vehicle                  Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  equipmentType            String?
  model                    String?
  vehicleYear              Int?
  vinOrSerial              String?
  description              String
  assignedManagerId        String?
  assignedManager          User?                   @relation("AssignedManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  files                    RequestFile[]
  items                    RequestItem[]
  documents                Document[]
  requestDocuments         RequestDocument[]
  commercialOffers         CommercialOffer[]
  invoices                 Invoice[]
  statusHistory            RequestStatusHistory[]
  ocrResults               OCRResult[]
  notifications            Notification[]
  comments                 RequestComment[]
  selectionBatches         RequestSelectionBatch[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([clientId])
  @@index([companyId])
  @@index([status])
  @@index([source])
  @@index([assignedManagerId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([manufacturerId])
  @@index([vehicleId])
}

model RequestFile {
  id         String      @id @default(cuid())
  requestId  String
  request    Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName   String
  storageKey String
  fileUrl    String?
  mimeType   String
  size       Int
  ocrResults OCRResult[]
  createdAt  DateTime    @default(now())

  @@index([requestId])
}

model RequestItem {
  id                   String                      @id @default(cuid())
  requestId            String
  request              Request                     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vehicleId            String?
  vehicle              Vehicle?                    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  equipmentType        String?
  name                 String
  brand                String?
  catalogNumber        String?
  analogNumber         String?
  quantity             Int                         @default(1)
  unit                 String                      @default("шт")
  supplierName         String?
  availability         String?
  deliveryTime         String?
  purchasePrice        Decimal?                    @db.Decimal(12, 2)
  salePrice            Decimal?                    @db.Decimal(12, 2)
  currency             String                      @default("UAH")
  comment              String?
  visibleToClient      Boolean                     @default(false)
  approvedByClient     Boolean                     @default(false)
  includeInInvoice     Boolean                     @default(false)
  approvedAt           DateTime?
  commercialOfferItems CommercialOfferItem[]
  invoiceItems         InvoiceItem[]
  selectionBatchItems  RequestSelectionBatchItem[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([requestId])
  @@index([vehicleId])
  @@index([visibleToClient])
  @@index([includeInInvoice])
}

model RequestSelectionBatch {
  id                    String                      @id @default(cuid())
  requestId             String
  request               Request                     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  revision              Int
  status                RequestSelectionBatchStatus @default(DRAFT)
  snapshotSchemaVersion Int
  snapshotHash          String                      @db.Char(64)
  createdByUserId       String?
  createdBy             User?                       @relation("RequestSelectionBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sentAt                DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  supersededAt          DateTime?
  items                 RequestSelectionBatchItem[]
  invoice               Invoice?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@unique([requestId, revision])
  @@index([requestId, status])
  @@index([createdByUserId])
  @@index([createdAt])
}

model RequestSelectionBatchItem {
  id                    String                          @id @default(cuid())
  batchId               String
  batch                 RequestSelectionBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceRequestItemId   String?
  sourceRequestItem     RequestItem?                    @relation(fields: [sourceRequestItemId], references: [id], onDelete: SetNull)
  position              Int
  status                RequestSelectionBatchItemStatus @default(PENDING)
  decisionByUserId      String?
  decisionBy            User?                           @relation("RequestSelectionBatchItemDecisionBy", fields: [decisionByUserId], references: [id], onDelete: SetNull)
  invoiceItem           InvoiceItem?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  clientComment         String?
  snapshotSchemaVersion Int
  snapshotHash          String                          @db.Char(64)
  sourceUpdatedAt       DateTime
  equipmentType         String?
  itemName              String
  brand                 String?
  catalogNumber         String?
  analogNumber          String?
  quantity              Int
  unit                  String
  availability          String?
  deliveryTime          String?
  approvedUnitPrice     Decimal?                        @db.Decimal(12, 2)
  currency              String
  managerComment        String?
  vehicleIdSnapshot     String?
  vehicleDisplayName    String?
  vehicleBrand          String?
  vehicleModel          String?
  vehicleYear           Int?
  vehicleVin            String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  @@unique([batchId, position])
  @@unique([batchId, sourceRequestItemId])
  @@index([batchId, status])
  @@index([sourceRequestItemId])
  @@index([snapshotHash])
  @@index([decisionByUserId])
}

model RequestDocument {
  id              String              @id @default(cuid())
  requestId       String
  request         Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type            RequestDocumentType
  title           String
  fileName        String
  fileUrl         String?
  storageKey      String?
  mimeType        String?
  size            Int?
  visibleToClient Boolean             @default(false)
  uploadedById    String?
  uploadedBy      User?               @relation("RequestDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([requestId])
  @@index([type])
  @@index([visibleToClient])
  @@index([uploadedById])
}

model CommercialOffer {
  id             String                @id @default(cuid())
  requestId      String
  request        Request               @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerNumber    String                @unique
  status         CommercialOfferStatus @default(DRAFT)
  currency       String                @default("UAH")
  subtotal       Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal               @default(0) @db.Decimal(12, 2)
  validUntil     DateTime?
  managerComment String?
  clientComment  String?
  createdById    String?
  createdBy      User?                 @relation("CommercialOfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentAt         DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  items          CommercialOfferItem[]

  @@index([requestId])
  @@index([status])
  @@index([createdById])
}

model CommercialOfferItem {
  id            String          @id @default(cuid())
  offerId       String
  offer         CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  requestItemId String?
  requestItem   RequestItem?    @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  name          String
  brand         String?
  catalogNumber String?
  analogNumber  String?
  quantity      Int             @default(1)
  unit          String?         @default("шт")
  price         Decimal         @default(0) @db.Decimal(12, 2)
  total         Decimal         @default(0) @db.Decimal(12, 2)
  availability  String?
  deliveryTime  String?
  comment       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([offerId])
  @@index([requestItemId])
}

model Invoice {
  id               String                 @id @default(cuid())
  requestId        String
  request          Request                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  selectionBatchId String?                @unique
  selectionBatch   RequestSelectionBatch? @relation(fields: [selectionBatchId], references: [id], onDelete: SetNull)
  companyId        String?
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  clientId         String?
  client           User?                  @relation("InvoiceClient", fields: [clientId], references: [id], onDelete: SetNull)
  invoiceNumber    String                 @unique @default(dbgenerated("nextval('invoice_number_seq'::regclass)::text"))
  status           InvoiceStatus          @default(DRAFT)
  currency         String                 @default("UAH")
  subtotal         Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal                @default(0) @db.Decimal(12, 2)
  managerComment   String?
  clientComment    String?
  sellerSnapshot   Json?
  buyerSnapshot    Json?
  createdById      String?
  createdBy        User?                  @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentAt           DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  items            InvoiceItem[]

  @@index([requestId])
  @@index([selectionBatchId])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([createdById])
}

model InvoiceItem {
  id                   String                     @id @default(cuid())
  invoiceId            String
  invoice              Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  requestItemId        String?
  requestItem          RequestItem?               @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  selectionBatchItemId String?                    @unique
  selectionBatchItem   RequestSelectionBatchItem? @relation(fields: [selectionBatchItemId], references: [id], onDelete: SetNull)
  name                 String
  brand                String?
  catalogNumber        String?
  analogNumber         String?
  quantity             Int                        @default(1)
  unit                 String?                    @default("шт")
  price                Decimal                    @default(0) @db.Decimal(12, 2)
  total                Decimal                    @default(0) @db.Decimal(12, 2)
  comment              String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([invoiceId])
  @@index([requestItemId])
  @@index([selectionBatchItemId])
}

model TelegramDraftRequest {
  id             String   @id @default(cuid())
  telegramUserId String   @unique
  chatId         String
  step           String
  phone          String?
  contactName    String?
  companyName    String?
  equipmentType  String?
  description    String?
  fileMetadata   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([chatId])
  @@index([step])
}

model RequestStatusHistory {
  id              String         @id @default(cuid())
  requestId       String
  request         Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  oldStatus       RequestStatus?
  newStatus       RequestStatus
  changedByUserId String?
  changedByUser   User?          @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([requestId])
  @@index([changedByUserId])
}

model RequestComment {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("RequestCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  message   String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([authorId])
}

model LogisticsTariffCity {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  price     Decimal            @db.Decimal(12, 2)
  isActive  Boolean            @default(true)
  requests  LogisticsRequest[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([isActive])
}

model LogisticsRequest {
  id                     String                     @id @default(cuid())
  requestNumber          String                     @unique @default(dbgenerated("'LG-'::text || lpad(nextval('logistics_request_number_seq'::regclass)::text, 6, '0'::text)"))
  status                 LogisticsRequestStatus     @default(NEW)
  clientId               String?
  client                 ClientProfile?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyId              String?
  company                Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactName            String
  contactPhone           String
  tariffCityId           String
  tariffCity             LogisticsTariffCity        @relation(fields: [tariffCityId], references: [id], onDelete: Restrict)
  tariffCityCodeSnapshot String
  tariffCityNameSnapshot String
  baseTariffSnapshot     Decimal                    @db.Decimal(12, 2)
  destinationType        LogisticsDestinationType
  baseAddressSnapshot    String?
  farmFormattedAddress   String?
  farmExternalAddressId  String?
  farmAddressProvider    LogisticsAddressProvider?
  farmNormalizedLocality String?
  pickupPointCount       Int
  additionalPointsCharge Decimal                    @db.Decimal(12, 2)
  farmDeliveryCharge     Decimal                    @db.Decimal(12, 2)
  totalPrice             Decimal                    @db.Decimal(12, 2)
  clientComment          String?                    @db.Text
  idempotencyKey         String                     @unique
  pickupPoints           LogisticsPickupPoint[]
  internalComments       LogisticsInternalComment[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([companyId, createdAt])
  @@index([tariffCityId])
  @@index([createdAt])
}

model LogisticsPickupPoint {
  id                           String                   @id @default(cuid())
  logisticsRequestId           String
  logisticsRequest             LogisticsRequest         @relation(fields: [logisticsRequestId], references: [id], onDelete: Cascade)
  formattedAddress             String
  externalAddressId            String?
  addressProvider              LogisticsAddressProvider
  normalizedLocality           String
  normalizedAdministrativeArea String?
  cargoDescription             String                   @db.Text
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@index([logisticsRequestId])
}

model LogisticsInternalComment {
  id                 String           @id @default(cuid())
  logisticsRequestId String
  logisticsRequest   LogisticsRequest @relation(fields: [logisticsRequestId], references: [id], onDelete: Cascade)
  authorUserId       String?
  author             User?            @relation("LogisticsInternalCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  body               String           @db.Text
  createdAt          DateTime         @default(now())

  @@index([logisticsRequestId, createdAt])
  @@index([authorUserId])
}

model Vehicle {
  id           String         @id @default(cuid())
  clientId     String?
  client       ClientProfile? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  companyId    String?
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name         String
  type         String
  manufacturer String
  model        String
  year         Int?
  vinOrSerial  String?
  comment      String?
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?          @relation("VehicleArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  requests     Request[]
  requestItems RequestItem[]
  documents    Document[]
  images       VehicleImage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([clientId])
  @@index([companyId])
  @@index([archivedAt])
  @@index([archivedById])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  publicId  String
  secureUrl String
  width     Int?
  height    Int?
  bytes     Int?
  format    String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([vehicleId, sortOrder])
  @@index([vehicleId, isPrimary])
}

model Document {
  id              String         @id @default(cuid())
  clientId        String?
  client          ClientProfile? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  companyId       String?
  company         Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestId       String?
  request         Request?       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fileName        String
  storageKey      String
  fileUrl         String?
  mimeType        String
  size            Int
  visibleToClient Boolean        @default(false)
  uploadedById    String?
  uploadedBy      User?          @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientId])
  @@index([clientId, visibleToClient])
  @@index([companyId])
  @@index([companyId, visibleToClient])
  @@index([requestId])
  @@index([vehicleId])
  @@index([vehicleId, visibleToClient])
  @@index([uploadedById])
}

model Category {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  subcategories Subcategory[]
  manufacturers Manufacturer[]
  requests      Request[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subcategory {
  id            String         @id @default(cuid())
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  description   String?
  manufacturers Manufacturer[]
  requests      Request[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Manufacturer {
  id             String                      @id @default(cuid())
  categoryId     String?
  category       Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId  String?
  subcategory    Subcategory?                @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  name           String
  slug           String
  isActive       Boolean                     @default(true)
  sortOrder      Int                         @default(0)
  requests       Request[]
  usedEquipment  UsedEquipment[]
  equipmentTypes ManufacturerEquipmentType[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([categoryId, subcategoryId, slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive, sortOrder])
}

model EquipmentType {
  id             String                      @id @default(cuid())
  name           String
  normalizedName String                      @unique
  slug           String                      @unique
  isActive       Boolean                     @default(true)
  sortOrder      Int                         @default(0)
  manufacturers  ManufacturerEquipmentType[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([isActive, sortOrder])
}

model ManufacturerEquipmentType {
  manufacturerId  String
  equipmentTypeId String
  manufacturer    Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@id([manufacturerId, equipmentTypeId])
  @@index([equipmentTypeId])
}

model UsedEquipment {
  id               String                 @id @default(cuid())
  slug             String                 @unique
  title            String
  equipmentType    String
  manufacturerId   String?
  manufacturer     Manufacturer?          @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  manufacturerName String
  model            String?
  year             Int?
  description      String                 @db.Text
  internalComment  String?                @db.Text
  status           UsedEquipmentStatus    @default(DRAFT)
  createdById      String
  createdBy        User                   @relation("UsedEquipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      String?
  updatedBy        User?                  @relation("UsedEquipmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedAt      DateTime?
  archivedAt       DateTime?
  images           UsedEquipmentImage[]
  inquiries        UsedEquipmentInquiry[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status])
  @@index([manufacturerId])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([status, publishedAt])
}

model UsedEquipmentImage {
  id                 String        @id @default(cuid())
  usedEquipmentId    String
  usedEquipment      UsedEquipment @relation(fields: [usedEquipmentId], references: [id], onDelete: Cascade)
  url                String
  cloudinaryPublicId String
  sortOrder          Int           @default(0)
  isPrimary          Boolean       @default(false)
  alt                String?
  width              Int?
  height             Int?
  format             String?
  bytes              Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([usedEquipmentId])
  @@index([usedEquipmentId, sortOrder])
  @@index([usedEquipmentId, isPrimary])
}

model UsedEquipmentInquiry {
  id                String                     @id @default(cuid())
  usedEquipmentId   String
  usedEquipment     UsedEquipment              @relation(fields: [usedEquipmentId], references: [id], onDelete: Restrict)
  equipmentTitle    String
  name              String
  phone             String
  normalizedPhone   String?
  status            UsedEquipmentInquiryStatus @default(NEW)
  assignedManagerId String?
  assignedManager   User?                      @relation("UsedEquipmentInquiryAssignee", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  internalComment   String?                    @db.Text
  source            String?
  processedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([usedEquipmentId])
  @@index([status])
  @@index([assignedManagerId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([normalizedPhone])
}

model OCRResult {
  id                   String       @id @default(cuid())
  requestId            String
  request              Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId               String?
  file                 RequestFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  rawText              String
  possibleSerialNumber String?
  possiblePartNumber   String?
  possibleModelNumber  String?
  correctedText        String?
  confidence           Float?
  provider             OCRProvider
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([requestId])
  @@index([fileId])
}

model Notification {
  id        String              @id @default(cuid())
  requestId String?
  request   Request?            @relation(fields: [requestId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  message   String
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([requestId])
  @@index([userId])
  @@index([status])
}

enum ContactMessageTopic {
  PARTS_REQUEST
  COMMERCIAL_OFFER
  REQUEST_QUESTION
  PARTNERSHIP
  OTHER
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  topic     ContactMessageTopic
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}
